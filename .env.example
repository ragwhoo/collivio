# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Neon PostgreSQL pooled connection string (Neon Console -> Connect).
DATABASE_URL=

# Neon Auth (Neon Console -> Auth).
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# At least 32 random characters.
NEON_AUTH_COOKIE_SECRET=
BETTER_AUTH_SECRET=

# Public origin of the app, used for redirects and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated allowlist. These emails receive the `admin` role on first
# sign-in. Leave empty to have no administrators.
ADMIN_EMAILS=

# Private S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...).
# When these are blank, upload fields fall back to pasted URLs.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to "true" for MinIO or other path-style endpoints.
S3_FORCE_PATH_STYLE=false

# Demo seed safety switch. The seed always refuses NODE_ENV=production
# unless ALLOW_SEED=true.
ALLOW_SEED=false
